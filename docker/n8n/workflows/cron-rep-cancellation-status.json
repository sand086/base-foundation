{
  "id": "cron-rep-cancellation-status",
  "name": "SAT - Estatus de cancelacion de REPs (diario 02:00)",
  "active": false,
  "versionId": "cron-rep-cancellation-status-v1",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [ { "field": "cronExpression", "expression": "0 2 * * *" } ] } },
      "id": "cron-rep-cancellation-status-trigger",
      "name": "Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [ 0, 0 ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://backend:8000/api/finance/receivables/payments/sync-cancellation-status",
        "options": { "timeout": 300000 }
      },
      "id": "cron-rep-cancellation-status-http",
      "name": "Llamar backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 240, 0 ]
    }
  ],
  "connections": { "Cron": { "main": [ [ { "node": "Llamar backend", "type": "main", "index": 0 } ] ] } },
  "settings": { "executionOrder": "v1", "timezone": "America/Mexico_City" }
}
