# Copiar a .env y ajustar. Lo leen docker compose, backend y frontend (Vite). NO subir .env a git.
# (No definas COMPOSE_PROJECT_NAME: pisaría el "name:" de cada compose y dev/prod compartirían proyecto.)

# QA | PROD (ambiente del PAC / timbrado)
ENVIRONMENT=QA
TZ=America/Mexico_City

# Puertos en el host
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_HOST_PORT=5432
N8N_PORT=5678
# Frontend QA (solo docker-compose.prod.yml)
FRONTEND_QA_PORT=8081

# PostgreSQL (el servicio db crea este usuario/base la PRIMERA vez que su volumen está vacío)
DB_SERVER=db
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=tms_db
# Base de datos del entorno QA (mismo Postgres que prod; se crea vacía)
DB_NAME_QA=qa_tms_db

# Backend
SECRET_KEY=
# Opcional: si se omite, QA usa SECRET_KEY (conviene distinta para que los tokens no crucen)
SECRET_KEY_QA=
GOOGLE_RECAPTCHA_V3_SECRET_KEY=
PAC_USER_QA=
PAC_PASS_QA=
PAC_USER_PROD=
PAC_PASS_PROD=

# Frontend (VITE_*; en prod se incrustan en el build)
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=
VITE_GOOGLE_RECAPTCHA_V3_SITE_KEY=
VITE_GEOAPIFY_API_KEY=
# Solo dev: a dónde proxea Vite /api
VITE_PROXY_TARGET=http://backend:8000

# n8n (crones)
# Generar con: openssl rand -hex 24  (¡no cambiarla después: cifra las credenciales de n8n!)
N8N_ENCRYPTION_KEY=
# URL pública de n8n (prod)
N8N_WEBHOOK_URL=http://localhost:5678/
